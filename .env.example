# Copy to .env and fill in -- the bridge and its tool server both read it.
# Real environment variables win over the file.

# --- Services on your network ---
OLLAMA_URL=http://10.7.163.103:11434
OLLAMA_MODEL=gemma3-12b-gpu
SEARXNG_URL=http://10.7.163.103:8080

# --- Web search fallback, used only when SearXNG is down ---
# Brave Search API, free tier: 2,000 queries a month.
BRAVE_API_KEY=

# Sent with every request the tools make. Wikipedia asks API users for a way
# to reach them -- add a contact URL or email before going public.
TOOLS_USER_AGENT=SlateBot/1.0 (self-hosted chat assistant)

# --- Serving ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
# 1 only behind a reverse proxy (Caddy, nginx, Cloudflare Tunnel...), so rate
# limits see each visitor's real address. Anywhere else, leave it at 0.
TRUST_PROXY=0

# --- Limits ---
# Rate limits, daily caps and request sizes: see "Limits for a public site"
# at the top of server/bridge.py. Any of them can be set here, for example:
# CHAT_PER_MINUTE=30
# DAILY_CHAT_CAP=5000
# DAILY_SEARCH_CAP=1000
